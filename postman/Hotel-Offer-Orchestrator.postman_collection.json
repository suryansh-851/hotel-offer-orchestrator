{
  "info": {
    "_postman_id": "70a74c8d-7262-4d21-aed0-2b2402761da4",
    "name": "Hotel Offer Orchestrator",
    "description": "Run all folders against the Compose API. Delhi has two overlaps and two exclusive hotels. Each simulated outage lasts for one request. Set baseUrl to test another host.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Supplier inventories",
      "item": [
        {
          "name": "Supplier A · Delhi inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierA/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierA",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 and JSON\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Three raw Delhi rows including both overlapping names\", function () {",
                  "  const rows = pm.response.json();",
                  "  pm.expect(rows).to.have.lengthOf(3);",
                  "  pm.expect(rows.map(row => row.name)).to.include.members(['Holtin', 'Radison']);",
                  "  rows.forEach(row => {",
                  "    pm.expect(row).to.have.all.keys('hotelId', 'name', 'price', 'city', 'commissionPct');",
                  "    pm.expect(row.city).to.eql('delhi');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Supplier B · Delhi inventory",
