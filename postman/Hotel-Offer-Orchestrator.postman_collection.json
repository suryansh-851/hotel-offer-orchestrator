    {
      "name": "Compare offers",
      "item": [
        {
          "name": "Delhi · overlaps and exclusive hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 and JSON\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Workflow ID returned\", function () {",
                  "  pm.expect(pm.response.headers.get('X-Workflow-Id')).to.match(/^hotels-[0-9a-f-]{36}$/);",
                  "});",
                  "pm.test(\"Exact winning rows in price order\", function () {",
                  "  pm.expect(pm.response.json()).to.deep.equal([{\"name\":\"Holtin\",\"price\":5340,\"supplier\":\"Supplier B\",\"commissionPct\":20},{\"name\":\"Radison\",\"price\":5900,\"supplier\":\"Supplier A\",\"commissionPct\":13},{\"name\":\"Neem Courtyard\",\"price\":7200,\"supplier\":\"Supplier A\",\"commissionPct\":9},{\"name\":\"Lotus Residency\",\"price\":8100,\"supplier\":\"Supplier B\",\"commissionPct\":11}]);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
