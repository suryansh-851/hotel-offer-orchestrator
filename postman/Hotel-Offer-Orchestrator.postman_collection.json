    {
      "name": "Health and outages",
      "item": [
        {
          "name": "Both suppliers healthy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 and JSON\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Reports both HTTP probes\", function () {",
                  "  const health = pm.response.json();",
                  "  pm.expect(health.status).to.eql('healthy');",
                  "  pm.expect(health.suppliers['Supplier A'].status).to.eql('up');",
                  "  pm.expect(health.suppliers['Supplier B'].status).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Supplier B probe fails",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Mock-Outage",
                "value": "B"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 503 and JSON\", function () {",
                  "  pm.response.to.have.status(503);",
                  "  pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Reports both HTTP probes\", function () {",
                  "  const health = pm.response.json();",
                  "  pm.expect(health.status).to.eql('degraded');",
                  "  pm.expect(health.suppliers['Supplier A'].status).to.eql('up');",
                  "  pm.expect(health.suppliers['Supplier B'].status).to.eql('down');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Supplier B returns an actual 503",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Mock-Outage",
                "value": "B"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/supplierB/hotels?city=delhi",
