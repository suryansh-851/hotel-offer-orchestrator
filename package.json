{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Compare hotel supplier offers with Temporal and Redis.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api.js",
    "worker": "node dist/worker.js",
    "lint": "eslint --max-warnings 0 .",
    "test": "npm run build && node --test \"test/*.test.cjs\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=dist/api.js --test-coverage-exclude=dist/worker.js --test-coverage-exclude=\"test/**\" \"test/*.test.cjs\"",
    "test:stack": "node --test test/stack.integration.cjs",
    "test:resilience": "node --test test/resilience.integration.cjs"
  },
  "dependencies": {
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/common": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@temporalio/testing": "1.26.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
